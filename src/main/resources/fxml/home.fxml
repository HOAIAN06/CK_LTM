<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" styleClass="root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nihongoquest.client.controller.HomeController">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="NIHONGO QUEST" styleClass="title"/>

    <Label text="Username"/>
    <TextField fx:id="usernameField" promptText="Nhập tên của bạn" maxWidth="280"/>

    <Button fx:id="findMatchButton" text="TÌM TRẬN" onAction="#onFindMatch" prefWidth="200"/>

</VBox>
