<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="24" styleClass="root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nihongoquest.client.controller.MatchmakingController">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="TÌM TRẬN 1V1" styleClass="title"/>
    <Label fx:id="usernameLabel" text="Người chơi"/>

    <ProgressIndicator fx:id="searchSpinner" progress="-1.0"
                       prefWidth="72" prefHeight="72"
                       styleClass="search-spinner"/>

    <Label fx:id="statusLabel" text="Đang gửi yêu cầu tìm trận..."
           styleClass="status-label" wrapText="true" maxWidth="360"/>

    <Button fx:id="cancelButton" text="HỦY TÌM TRẬN"
            onAction="#onCancel" prefWidth="200"/>

</VBox>
