<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root,app-shell"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nihongoquest.client.quiz.QuizLobbyController">
    <center>
        <VBox spacing="14" styleClass="page-content,page-surface">
            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="lobby-header-card">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="SẢNH CHỜ QUIZ" styleClass="lobby-eyebrow"/>
                    <Label fx:id="titleLabel" text="Bộ đề" styleClass="lobby-title"/>
                    <Label text="Chia sẻ mã PIN để mời người chơi vào phòng."
                           styleClass="helper-text"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="countLabel" text="0/20 người chơi"
                               styleClass="lobby-count-chip"/>
                        <Label text="Host bắt đầu khi có ít nhất 2 người chơi."
                               styleClass="lobby-meta-text"/>
                    </HBox>
                </VBox>
                <VBox alignment="CENTER" spacing="1" styleClass="lobby-pin-panel">
                    <Label text="MÃ PIN" styleClass="lobby-pin-caption"/>
                    <Label fx:id="pinLabel" text="------" styleClass="lobby-pin"/>
                    <Button fx:id="copyPinButton" text="Sao chép PIN"
                            onAction="#onCopyPin" styleClass="copy-button"/>
                </VBox>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="NGƯỜI CHƠI TRONG PHÒNG"
                               styleClass="lobby-section-title" HBox.hgrow="ALWAYS"/>
                        <Label text="Sẵn sàng khi host bấm bắt đầu"
                               styleClass="helper-text"/>
                    </HBox>
                    <ListView fx:id="playerList" VBox.vgrow="ALWAYS"
                              styleClass="quiz-list,lobby-player-list"/>
                </VBox>

                <VBox spacing="10" prefWidth="330" maxWidth="330"
                      styleClass="lobby-side-panel">
                    <VBox fx:id="cameraPanel" spacing="8" visible="false" managed="false"
                          styleClass="lobby-camera-card">
                        <Label text="CAMERA CỦA BẠN" styleClass="camera-caption"/>
                        <StackPane styleClass="camera-preview-shell">
                            <ImageView fx:id="cameraPreview" fitWidth="286" fitHeight="215"
                                       preserveRatio="true" smooth="true"/>
                        </StackPane>
                        <Button fx:id="retryCameraButton" text="Thử bật camera lại"
                                visible="false" managed="false" onAction="#onRetryCamera"
                                maxWidth="Infinity" styleClass="secondary-button"/>
                    </VBox>

                    <VBox spacing="8" styleClass="lobby-info-card">
                        <Label text="THÔNG TIN PHÒNG" styleClass="lobby-section-title"/>
                        <Label text="• Host bắt đầu khi có ít nhất 2 người chơi đang kết nối."
                               wrapText="true" styleClass="lobby-info-line"/>
                        <Label text="• Phòng giám sát tối đa 6 người; phòng thường tối đa 20."
                               wrapText="true" styleClass="lobby-info-line"/>
                        <Label text="• Camera lỗi không chặn việc tham gia hoặc bắt đầu."
                               wrapText="true" styleClass="lobby-info-line"/>
                    </VBox>

                    <Label fx:id="proctoringLabel" visible="false" managed="false"
                           wrapText="true" styleClass="proctoring-note"/>
                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="lobby-action-bar">
                <Label fx:id="statusLabel" text="" wrapText="true"
                       styleClass="status-label,lobby-status"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="leaveButton" text="Rời phòng" onAction="#onLeave"
                        styleClass="danger-outline-button"/>
                <Button fx:id="startButton" text="BẮT ĐẦU" onAction="#onStart"
                        prefWidth="180" styleClass="large-button"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
