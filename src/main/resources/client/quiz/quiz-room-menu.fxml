<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root,app-shell"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nihongoquest.client.quiz.QuizRoomMenuController">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="quiz-menu-scroll">
            <VBox spacing="18" styleClass="page-content,quiz-menu-page,page-surface,quiz-room-page">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="BẮT ĐẦU MỘT PHÒNG QUIZ"
                               styleClass="quiz-menu-eyebrow"/>
                        <Label text="Tạo phòng mới hoặc tham gia bằng mã PIN 6 chữ số."
                               styleClass="helper-text"/>
                    </VBox>
                    <Label text="Tối đa 20 người • 6 khi giám sát"
                           styleClass="quiz-meta-chip"/>
                </HBox>

                <HBox alignment="TOP_LEFT" spacing="18">
                    <VBox spacing="12" HBox.hgrow="ALWAYS" maxHeight="Infinity"
                          styleClass="quiz-action-card,quiz-action-create">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane fx:id="createIcon"
                                       styleClass="quiz-action-icon,quiz-action-icon-create"/>
                            <VBox spacing="1">
                                <Label text="TẠO PHÒNG" styleClass="quiz-action-title"/>
                                <Label text="Chọn bộ đề, thời lượng và chế độ giám sát."
                                       styleClass="quiz-action-copy"/>
                            </VBox>
                        </HBox>

                        <Separator styleClass="quiz-card-separator"/>

                        <Label text="Bộ đề đã xuất bản" styleClass="field-caption"/>
                        <ComboBox fx:id="quizSetCombo" maxWidth="Infinity"/>

                        <Label text="Thời lượng chung" styleClass="field-caption"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Spinner fx:id="durationSpinner" editable="true" prefWidth="110"/>
                            <Label text="phút (1–15)" styleClass="helper-text"/>
                        </HBox>

                        <Label text="Chế độ phòng" styleClass="field-caption"/>
                        <CheckBox fx:id="hostPlaysCheck" text="Host cũng tham gia trả lời"
                                  selected="true"/>
                        <CheckBox fx:id="proctoringCheck" text="Bật giám sát camera"/>
                        <Label text="Khi bật giám sát, host chỉ điều khiển phòng. Camera lỗi không chặn việc bắt đầu."
                               wrapText="true" styleClass="quiz-inline-note"/>

                        <Region VBox.vgrow="ALWAYS"/>
                        <Button fx:id="createButton" text="TẠO PHÒNG VÀ LẤY PIN"
                                onAction="#onCreate" maxWidth="Infinity"
                                styleClass="primary-button,large-button"/>
                    </VBox>

                    <VBox spacing="12" prefWidth="340" maxWidth="340" maxHeight="Infinity"
                          styleClass="quiz-action-card,quiz-action-join">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane fx:id="joinIcon"
                                       styleClass="quiz-action-icon,quiz-action-icon-join"/>
                            <VBox spacing="1">
                                <Label text="VÀO PHÒNG" styleClass="quiz-action-title"/>
                                <Label text="Nhập mã PIN do host cung cấp."
                                       styleClass="quiz-action-copy"/>
                            </VBox>
                        </HBox>

                        <Separator styleClass="quiz-card-separator"/>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Mã PIN" styleClass="field-caption" HBox.hgrow="ALWAYS"/>
                            <Label text="6 CHỮ SỐ" styleClass="pin-length-chip"/>
                        </HBox>
                        <TextField fx:id="pinField" promptText="123456"
                                   maxWidth="Infinity" alignment="CENTER"
                                   styleClass="pin-input,pin-field"/>
                        <Label text="Hỏi host mã PIN trên màn hình sảnh chờ của họ."
                               wrapText="true" styleClass="helper-text"/>

                        <Region VBox.vgrow="ALWAYS"/>
                        <Button fx:id="joinButton" text="THAM GIA PHÒNG"
                                onAction="#onJoin" maxWidth="Infinity"
                                styleClass="primary-button,large-button"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER" spacing="0" styleClass="quiz-steps-bar">
                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="1" styleClass="quiz-step-index"/>
                        <VBox spacing="1">
                            <Label text="Tạo phòng" styleClass="quiz-step-title"/>
                            <Label text="Chọn bộ đề và thời lượng."
                                   styleClass="quiz-step-copy"/>
                        </VBox>
                    </HBox>
                    <Region styleClass="quiz-step-divider">
                        <HBox.margin>
                            <Insets left="14" right="14"/>
                        </HBox.margin>
                    </Region>
                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="2" styleClass="quiz-step-index"/>
                        <VBox spacing="1">
                            <Label text="Chia sẻ PIN" styleClass="quiz-step-title"/>
                            <Label text="Gửi mã 6 chữ số cho người chơi."
                                   styleClass="quiz-step-copy"/>
                        </VBox>
                    </HBox>
                    <Region styleClass="quiz-step-divider">
                        <HBox.margin>
                            <Insets left="14" right="14"/>
                        </HBox.margin>
                    </Region>
                    <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="3" styleClass="quiz-step-index"/>
                        <VBox spacing="1">
                            <Label text="Bắt đầu" styleClass="quiz-step-title"/>
                            <Label text="Host bấm bắt đầu khi đủ người."
                                   styleClass="quiz-step-copy"/>
                        </VBox>
                    </HBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" styleClass="quiz-status-bar">
            <Label fx:id="statusLabel" text="" styleClass="status-label"/>
        </HBox>
    </bottom>
</BorderPane>
