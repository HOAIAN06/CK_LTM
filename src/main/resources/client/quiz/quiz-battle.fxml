<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root,app-shell"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nihongoquest.client.quiz.QuizBattleController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="gameplay-header">
            <StackPane styleClass="battle-brand-mark">
                <Label text="N" styleClass="battle-brand-mark-text"/>
            </StackPane>
            <VBox spacing="1" HBox.hgrow="ALWAYS">
                <Label text="QUIZ ROOM" styleClass="gameplay-eyebrow"/>
                <Label fx:id="titleLabel" text="Bộ đề" styleClass="header-page-title"/>
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <VBox alignment="CENTER" spacing="1" styleClass="header-pill">
                    <Label text="MÃ PIN" styleClass="header-pill-caption"/>
                    <Label fx:id="pinLabel" text="------" styleClass="header-pill-value"/>
                </VBox>
                <VBox alignment="CENTER" spacing="1"
                      styleClass="header-pill,header-pill-time">
                    <Label text="THỜI GIAN PHÒNG" styleClass="header-pill-caption"/>
                    <Label fx:id="roomTimeLabel" text="3:00"
                           styleClass="quiz-room-time,header-time-value"/>
                </VBox>
            </HBox>
        </HBox>
    </top>
    <center>
        <HBox spacing="16" styleClass="battle-content,page-surface,quiz-battle-page">
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="battle-hud">
                    <VBox spacing="1" styleClass="battle-score-block">
                        <Label text="ĐIỂM CỦA BẠN" styleClass="battle-hud-caption"/>
                        <Label fx:id="scoreLabel" text="0 điểm" styleClass="battle-score"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="5" styleClass="battle-timer-block">
                        <HBox alignment="CENTER_RIGHT" spacing="8">
                            <Label text="THỜI GIAN CÂU" styleClass="timer-caption"/>
                            <Label fx:id="questionTimeLabel" text="--"
                                   styleClass="battle-timer-value"/>
                        </HBox>
                        <ProgressBar fx:id="questionProgress" progress="0"
                                     prefWidth="300" styleClass="time-progress,battle-time-progress"/>
                    </VBox>
                </HBox>

                <Label fx:id="cameraBanner" visible="false" managed="false"
                       styleClass="error-banner" wrapText="true"/>
                <Label fx:id="toastLabel" visible="false" managed="false"
                       wrapText="true" styleClass="toast-banner"/>

                <VBox spacing="12" styleClass="question-card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="CÂU HỎI" styleClass="question-eyebrow"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Chọn đáp án đúng" styleClass="helper-text"/>
                    </HBox>
                    <Label fx:id="questionLabel" text="Đang chuẩn bị câu hỏi"
                           wrapText="true" maxWidth="Infinity" styleClass="battle-question"/>

                    <GridPane hgap="12" vgap="12" styleClass="answer-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Button fx:id="answerAButton" text="A" onAction="#onAnswer"
                                wrapText="true" maxWidth="Infinity" styleClass="answer-button"
                                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Button fx:id="answerBButton" text="B" onAction="#onAnswer"
                                wrapText="true" maxWidth="Infinity" styleClass="answer-button"
                                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button fx:id="answerCButton" text="C" onAction="#onAnswer"
                                wrapText="true" maxWidth="Infinity" styleClass="answer-button"
                                GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Button fx:id="answerDButton" text="D" onAction="#onAnswer"
                                wrapText="true" maxWidth="Infinity" styleClass="answer-button"
                                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </GridPane>

                    <Region VBox.vgrow="ALWAYS"/>
                    <Label fx:id="statusLabel" text="" wrapText="true"
                           styleClass="status-label,battle-status"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="battle-footer-bar">
                    <Label text="Câu hỏi và điểm số do server quyết định."
                           styleClass="helper-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="leaveButton" text="Rời phòng" onAction="#onLeave"
                            styleClass="danger-outline-button"/>
                </HBox>
            </VBox>

            <VBox spacing="10" prefWidth="330" maxWidth="330"
                  styleClass="quiz-side-panel,battle-side-panel">
                <VBox fx:id="cameraSection" spacing="6" visible="false" managed="false">
                    <Label fx:id="cameraCaption" text="CAMERA GIÁM SÁT"
                           styleClass="camera-caption"/>
                    <StackPane fx:id="cameraPreviewHolder" prefWidth="298" prefHeight="168"
                               visible="false" managed="false"
                               styleClass="camera-preview-shell"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="BẢNG XẾP HẠNG" styleClass="section-title"
                           HBox.hgrow="ALWAYS"/>
                    <Label text="TRỰC TIẾP" styleClass="live-chip"/>
                </HBox>
                <ListView fx:id="leaderboardList" VBox.vgrow="ALWAYS"
                          styleClass="leaderboard-list"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
