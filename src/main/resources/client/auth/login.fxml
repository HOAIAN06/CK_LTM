<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane styleClass="root,auth-page"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nihongoquest.client.auth.LoginController">
    <Pane mouseTransparent="true">
        <Circle radius="190" layoutX="120" layoutY="110" styleClass="auth-orb,auth-orb-sakura"/>
        <Circle radius="105" layoutX="420" layoutY="590" styleClass="auth-orb,auth-orb-accent"/>
        <Circle radius="230" layoutX="940" layoutY="620" styleClass="auth-orb,auth-orb-soft"/>
    </Pane>

    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED" styleClass="auth-scroll">
        <StackPane alignment="CENTER">
            <HBox alignment="CENTER" spacing="36" maxWidth="1080">
                <padding>
                    <Insets top="28" right="32" bottom="28" left="32"/>
                </padding>

                <VBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS"
                      minWidth="0" styleClass="auth-brand-panel">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane styleClass="auth-brand-mark">
                            <Label text="N" styleClass="auth-brand-mark-text"/>
                        </StackPane>
                        <VBox spacing="0">
                            <Label text="NIHONGO" styleClass="auth-brand-primary"/>
                            <Label text="QUEST" styleClass="auth-brand-accent"/>
                        </VBox>
                    </HBox>

                    <Label text="Học tiếng Nhật qua từng trận đấu"
                           wrapText="true" maxWidth="470" styleClass="auth-headline"/>
                    <Label text="Rèn từ vựng, kanji và phản xạ với đối thủ thời gian thực. Mỗi câu trả lời là một bước tiến trên hành trình chinh phục tiếng Nhật."
                           wrapText="true" maxWidth="440" styleClass="auth-copy"/>

                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="auth-feature-row">
                            <StackPane fx:id="featureIconOne" styleClass="auth-feature-icon"/>
                            <VBox spacing="1">
                                <Label text="Đấu 1v1 theo thời gian thực"
                                       styleClass="auth-feature-title"/>
                                <Label text="Rèn phản xạ với đối thủ cùng trình độ."
                                       styleClass="auth-feature-copy"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="auth-feature-row">
                            <StackPane fx:id="featureIconTwo" styleClass="auth-feature-icon"/>
                            <VBox spacing="1">
                                <Label text="Phòng Quiz nhiều người"
                                       styleClass="auth-feature-title"/>
                                <Label text="Tạo phòng, chia sẻ PIN và thi đấu cùng lớp."
                                       styleClass="auth-feature-copy"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="auth-feature-row">
                            <StackPane fx:id="featureIconThree" styleClass="auth-feature-icon"/>
                            <VBox spacing="1">
                                <Label text="Theo dõi tiến bộ"
                                       styleClass="auth-feature-title"/>
                                <Label text="Điểm số, độ chính xác và lịch sử được lưu lại."
                                       styleClass="auth-feature-copy"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Label text="日本語 • 毎日 一歩" styleClass="auth-stamp"/>
                </VBox>

                <VBox alignment="CENTER" spacing="10" styleClass="auth-card"
                      prefWidth="420" minWidth="420" maxWidth="420">
                    <Label text="NIHONGOQUEST" styleClass="brand-title"/>
                    <Label fx:id="authTitle" text="ĐĂNG NHẬP" styleClass="auth-title"/>
                    <Label fx:id="authSubtitle" text="Chào mừng bạn quay lại"
                           styleClass="auth-subtitle"/>

                    <TextField fx:id="usernameField" promptText="Username" maxWidth="340"/>
                    <PasswordField fx:id="passwordField" promptText="Mật khẩu"
                                   maxWidth="340" onAction="#onSubmit"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Xác nhận mật khẩu" maxWidth="340"
                                   onAction="#onSubmit" visible="false" managed="false"/>

                    <Button fx:id="submitButton" text="ĐĂNG NHẬP" onAction="#onSubmit"
                            prefWidth="340" maxWidth="340"
                            styleClass="primary-button,large-button" disable="true"/>

                    <Label fx:id="statusLabel" text="Hãy kết nối server trước khi đăng nhập"
                           styleClass="status-label" wrapText="true" maxWidth="340"/>

                    <HBox alignment="CENTER" spacing="4">
                        <Label fx:id="modePromptLabel" text="Chưa có tài khoản?"/>
                        <Hyperlink fx:id="modeLink" text="Đăng ký"
                                   onAction="#onToggleMode" styleClass="mode-link"/>
                    </HBox>

                    <Separator styleClass="auth-separator"/>

                    <TitledPane fx:id="serverConfigPane" text="Cấu hình server"
                                styleClass="auth-server-pane" expanded="false" animated="false"
                                prefWidth="340" maxWidth="340">
                        <content>
                            <GridPane hgap="8" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                    <ColumnConstraints prefWidth="88"/>
                                </columnConstraints>
                                <Label text="Địa chỉ IP hoặc hostname" styleClass="field-caption"
                                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label text="Cổng" styleClass="field-caption"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <TextField fx:id="serverHostField"
                                           promptText="Ví dụ: 192.168.1.100"
                                           maxWidth="Infinity"
                                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <TextField fx:id="serverPortField" promptText="5000"
                                           maxWidth="Infinity" onAction="#onConnect"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Button fx:id="connectButton" text="KẾT NỐI"
                                        onAction="#onConnect" maxWidth="Infinity"
                                        styleClass="secondary-button"
                                        GridPane.columnIndex="0" GridPane.rowIndex="2"
                                        GridPane.columnSpan="2"/>
                            </GridPane>
                        </content>
                    </TitledPane>

                    <Label fx:id="connectionStatusLabel" text="Chưa kết nối tới server"
                           styleClass="connection-status-pill" wrapText="true"
                           maxWidth="340"/>
                </VBox>
            </HBox>
        </StackPane>
    </ScrollPane>
</StackPane>
