{
  "name": "nihongoquest-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NihongoQuest desktop client (Electron + React + TypeScript)",
  "main": "./out/main/index.js",
  "author": "NihongoQuest",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "14.14.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.9.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "27.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
